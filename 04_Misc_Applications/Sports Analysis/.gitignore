# .gitignore - 版本控制排除清單

# === 絕對不能提交的敏感檔案 ===
.env
*.env.local

# === 資料庫與輸出檔案 ===
data/
output/
logs/

# === Python 快取 ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# === 虛擬環境 ===
venv/
env/
.venv/
.env/

# === 測試覆蓋率 ===
.coverage
htmlcov/
.pytest_cache/

# === IDE 設定 ===
.vscode/
.idea/
*.swp
*.swo

# === 發布產物 ===
dist/
build/
*.egg-info/
