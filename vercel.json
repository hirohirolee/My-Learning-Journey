{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/03_Web_Portfolio/v2_executive_theme/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/03_Web_Portfolio/v2_executive_theme/index.html"
    },
    {
      "source": "/ai-studio.html",
      "destination": "/03_Web_Portfolio/v2_executive_theme/ai-studio.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/03_Web_Portfolio/v2_executive_theme/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/03_Web_Portfolio/v2_executive_theme/js/$1"
    },
    {
      "source": "/data/(.*)",
      "destination": "/03_Web_Portfolio/v2_executive_theme/data/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/03_Web_Portfolio/v2_executive_theme/assets/$1"
    }
  ]
}
