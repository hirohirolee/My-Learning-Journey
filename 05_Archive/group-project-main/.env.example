SUPABASE_URL=https://your-project.supabase.co

# Public anon key. Use only where RLS policies are correctly configured.
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Secret service role key. Backend only; never put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backward-compatible alias. Leave blank or set to the same value as SUPABASE_SERVICE_ROLE_KEY for backend-only use.
SUPABASE_KEY=
SUPABASE_TABLE_NAME=master_reviews
SUPABASE_RESULT_TABLE_NAME=master_reviews_result

ENGINE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

MAX_RECORDS=
BATCH_SIZE=10
SLEEP_SECONDS=1.0
ML_GATEKEEPER_THRESHOLD=0.7
