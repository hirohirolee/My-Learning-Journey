# Copy this content into Streamlit Cloud:
# App settings -> Secrets
#
# Do not commit a real .streamlit/secrets.toml file.

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-supabase-anon-or-service-role-key"
# Browser-safe key used by the embedded dashboard when submitting AI replies.
# Use your Supabase anon/public key here, not the service_role secret.
SUPABASE_PUBLIC_KEY = "your-supabase-anon-public-key"
SUPABASE_TABLE_NAME = "master_reviews_result"

# Optional. Only needed when OpenAI-backed features are enabled.
OPENAI_API_KEY = "sk-your-openai-api-key"

# Optional ML / app settings.
ML_GATEKEEPER_THRESHOLD = "0.7"
# 0 or blank means fetch all rows. Set a positive number only when you want to limit rows.
DASHBOARD_LIMIT = "0"
# Streamlit iframe height. Keep this near the visible browser height so the left brand filter stays visible.
STREAMLIT_COMPONENT_HEIGHT = "820"

# Alternative nested format also supported by streamlit_dashboard.py:
#
# [supabase]
# url = "https://your-project.supabase.co"
# key = "your-supabase-anon-or-service-role-key"
# table_name = "master_reviews_result"
#
# [openai]
# api_key = "sk-your-openai-api-key"
